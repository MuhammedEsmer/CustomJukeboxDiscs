[Unit]
Description=Custom Jukebox Discs YouTube Import Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/customjukeboxdiscs-youtube
EnvironmentFile=/opt/customjukeboxdiscs-youtube/.env
ExecStart=/usr/bin/node src/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/customjukeboxdiscs-youtube

[Install]
WantedBy=multi-user.target
